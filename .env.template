# ==============================================================================
# Willy - Configurações Padrão de Distribuição (Sem chaves pessoais)
# Obtenha sua chave gratuita em: https://console.groq.com/keys
# ==============================================================================

GROQ_API_KEY=

# Atalhos de Teclado
VOICE_HOTKEY=ctrl+space
TRANSLATE_HOTKEY=ctrl+alt+space
TRANSLATE_ES_HOTKEY=ctrl+alt+n
MASTER_HOTKEY=ctrl+shift+space
MEETING_HOTKEY=ctrl+alt+r
PROMPT_HOTKEY=ctrl+alt+p
HISTORY_HOTKEY=ctrl+alt+h
UNDO_HOTKEY=ctrl+alt+z
SEND_HOTKEY=ctrl+shift+enter
SPEAK_HOTKEY=ctrl+alt+s
STICKY_HOTKEY=ctrl+alt+f
CAPTIONS_HOTKEY=ctrl+alt+l
TRANSFORM_HOTKEY=ctrl+alt+t
PROFILE_HOTKEY=ctrl+alt+e

# Modelos da Groq e Perfil de IA (dev | executivo | puro)
GROQ_MODEL=whisper-large-v3-turbo
GROQ_TRANSLATE_MODEL=whisper-large-v3
GROQ_LLM_MODEL=openai/gpt-oss-120b
PROCESSING_PROFILE=dev

# Preferências Visuais e Operacionais
REFINE_PROMPT=true
SILENT_MODE=false
WHISPER_MODE=false
PILL_POSITION=centro_inferior
CLEAN_FILLERS=true
CLIPBOARD_ONLY=false
SMART_PARAGRAPHING=true
OUTPUT_TONE=natural
INPUT_LANGUAGE=auto
SAVE_AUDIO_FILES=false
SILERO_VAD=true
WAKE_WORD_ENABLED=false
AUDIO_DEVICE=
SYSTEM_AUDIO_DEVICE=
MIC_GAIN=1.0
PRIVATE_MODE=false
OUTPUTS_DIR=

# Detecção Automática de Voz e Silêncio
AUTO_SILENCE=true
SILENCE_SECONDS=2.2
SILENCE_THRESHOLD=0.005
SPEECH_THRESHOLD=0.009

# Guia Inicial (Onboarding)
ONBOARDING_COMPLETED=false


